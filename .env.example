# Copy to .env.local (development) or set in your hosting provider's dashboard.
# Never commit real values.

# Public URL of the live site: used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://thejoyfulartistry.com

# Enquiry form (required for the form to send)
# Create an API key at https://resend.com and verify the sending domain
# (e.g. thejoyfulartistry.com) so ENQUIRY_FROM_EMAIL is allowed to send.
RESEND_API_KEY=
# Sender shown on enquiry notifications. Must use the verified domain.
ENQUIRY_FROM_EMAIL="Joyful Artistry Website <enquiries@thejoyfulartistry.com>"
# Where enquiries are delivered (comma-separate for multiple). Defaults to the email in src/config/site.ts.
ENQUIRY_TO_EMAIL=info@thejoyfulartistry.com

# Instagram live feed (optional)
# Long-lived token from the official Instagram API with Instagram Login for the
# @joyfulartistry professional account. Leave empty to show the curated gallery.
# Tokens expire after 60 days unless refreshed.
INSTAGRAM_ACCESS_TOKEN=
